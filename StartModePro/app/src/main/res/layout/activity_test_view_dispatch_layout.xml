<?xml version="1.0" encoding="utf-8"?>
<com.zjt.startmodepro.view_dispatch.MyLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/my_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f6f6f6"
    android:orientation="vertical">

    <com.zjt.startmodepro.view_dispatch.MyButton
        android:id="@+id/my_btn"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="btn click"
        android:textSize="26sp" />

    <com.zjt.startmodepro.view_dispatch.MyTextView
        android:id="@+id/my_txt"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:gravity="center"
        android:background="@color/color_f3ac30"
        android:text="textview click"
        android:textColor="@color/white"
        android:textSize="26sp" />

    <EditText
        android:id="@+id/edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="123456789"
        android:textColor="@color/color_8f66ff"
        android:textSize="@dimen/dimen_20sp" />

</com.zjt.startmodepro.view_dispatch.MyLinearLayout>